# Copy this file to .env.local for local development only.
# Do not commit real secrets or database URLs.

# Public Render auth proxy used by the mobile/static app.
VITE_AUTH_PROXY_URL=https://animevaultofficial-github-io.onrender.com

# Optional local overrides. Configure real values in Render/GitHub secrets, not in git.
VITE_RENDER_AUTH_PROXY_URL=
VITE_NEON_AUTH_URL=
VITE_DATABASE_URL=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
