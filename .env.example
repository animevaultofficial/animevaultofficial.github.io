# Copy this file to .env.local for local development only.
# Do not commit real secrets or database URLs.
# ============================================================================
# CRITICAL: Configure these variables for API & Database connectivity
# ============================================================================

# -------- ANFIRE API CONFIGURATION (Required) --------
# Full URL to the AnFire API endpoint for fetching anime data
# Example: http://localhost:3000/api.php or https://your-api-domain.com/api.php
VITE_ANFIRE_API_URL=http://localhost:3000/api.php

# API key for AnFire API authentication
# Get this from your API provider or generate in your backend
VITE_ANFIRE_API_KEY=your-api-key-here

# Separate endpoint for anime episode/stream data (optional, defaults to VITE_ANFIRE_API_URL)
# This is used for fetching video stream URLs and episode information
VITE_ANFIRE_EPISODE_API_URL=http://localhost:3000/api.php

# -------- DATABASE CONFIGURATION --------
# Neon (PostgreSQL) database connection URL
# Format: postgresql://user:password@host:5432/database
# This is used for storing user data, watchlists, and preferences
VITE_DATABASE_URL=postgresql://user:password@localhost:5432/animevault

# Neon auth/serverless endpoint
# Used for PostgreSQL serverless connections and authentication
VITE_NEON_AUTH_URL=https://your-neon-project.neon.tech/api/auth

# -------- AUTHENTICATION PROXY --------
# Public auth proxy URL (for mobile/static app)
# This should be your Render deployment or authentication service
# Used for OAuth and user session management
VITE_AUTH_PROXY_URL=https://animevaultofficial-github-io.onrender.com

# hCaptcha site key for login/signup bot protection.
# Leave blank to disable CAPTCHA in local dev or if the site key is not configured.
VITE_HCAPTCHA_SITEKEY=

# Secret key used server-side to validate hCaptcha tokens.
# Keep this out of the browser and out of source control.
HCAPTCHA_SECRET_KEY=

# Local override for auth proxy (optional)
# Use this to test with a local auth server during development
VITE_RENDER_AUTH_PROXY_URL=

# -------- CLOUDINARY (Optional - for image uploads) --------
# Your Cloudinary cloud name
# Get this from your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Your Cloudinary unsigned upload preset
# Create an unsigned upload preset in Cloudinary for public image uploads
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================================================
# GITHUB ACTIONS SECRETS SETUP
# ============================================================================
# 
# For CI/CD builds to work properly, add these secrets to your repository:
# 
# 1. Go to: Settings → Secrets and variables → Actions
# 2. Create New Repository Secret with each of these:
#
#    Secret Name                       Example Value
#    ============                       =============
#    VITE_ANFIRE_API_URL               http://your-api.com/api.php
#    VITE_ANFIRE_API_KEY               your-secure-api-key
#    VITE_ANFIRE_EPISODE_API_URL       http://your-api.com/api.php
#    VITE_DATABASE_URL                 postgresql://user:pass@host:5432/db
#    VITE_NEON_AUTH_URL                https://your-neon.neon.tech/api/auth
#    VITE_AUTH_PROXY_URL               https://your-proxy.onrender.com
#    VITE_CLOUDINARY_CLOUD_NAME        your-cloud
#    VITE_CLOUDINARY_UPLOAD_PRESET     your-preset
#    CSC_KEY_PASSWORD                  your-code-signing-password (for Windows cert)
#
# Without these secrets, builds will use fallback/default values.
#
# ============================================================================
# CAPACITOR & ANDROID BUILD NOTES
# ============================================================================
#
# For Android builds to succeed:
# 
# 1. Ensure capacitor.config.json is configured correctly:
#    - appId: "com.animevault.app" (must be unique)
#    - webDir: "dist-mobile" (Vite output directory)
#    - androidScheme: "https" (for secure communication)
#
# 2. Mobile app entry point: src/mobile/main.jsx
#    - Uses src/mobile/index.html as the HTML entry
#    - Loads AppMobile component from src/mobile/AppMobile.jsx
#
# 3. Environment variables ARE passed to mobile builds
#    - All VITE_* variables are available in import.meta.env
#    - Mobile app initializes DB and fetches settings on startup
#
# 4. If APK appears invalid or app won't start:
#    a) Check database connection: VITE_DATABASE_URL format
#    b) Verify API endpoints are accessible from the device/emulator
#    c) Check browser console for connection errors
#    d) Ensure all required secrets are set in GitHub Actions
#
# ============================================================================
# LOCAL DEVELOPMENT SETUP
# ============================================================================
#
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Fill in your local values
#
# 3. Start dev server:
#    npm install
#    npm run dev
#
# 4. Build mobile:
#    npm run android:build
#
# ============================================================================
